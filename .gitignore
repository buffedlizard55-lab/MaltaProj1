# Raw third-party page bodies are CI evidence artifacts, never published site content.
# pipeline/_scratch/ was a TEMPORARY development folder (removed before the final PR).
pipeline/probe/raw/
evidence/
__pycache__/
*.py[cod]
*.pyc
$py.class
.venv/
# Raw public source responses and browser tooling stay outside Git.
.cache/
.arena/
node_modules/
.pytest_cache/
coverage/
dist/
.env
.env.*
# Keep only deliberately curated, small evidence snapshots under data/evidence/.
# This session's bounded, privacy-minimized primary evidence is a requested deliverable.
!data/snapshot/evidence/
!data/snapshot/evidence/*.json.gz
!dashboard/data/evidence/
!dashboard/data/evidence/*.json.gz

# Raw third-party page bodies are CI evidence only, never site content.
winboard/raw/
winboard/data/_debug/*.txt
winboard/data/_debug/*_blob*.json
